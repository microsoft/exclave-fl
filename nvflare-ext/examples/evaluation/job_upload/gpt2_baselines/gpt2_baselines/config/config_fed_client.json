{
  "format_version": 2,

  "DATASET_ROOT": "/data/NCBI-disease",

  "executors": [
    {
      "tasks": [
        "train",
        "validate"
      ],
      "executor": {
        "id": "Executor",
        "name": "LearnerExecutor",
        "args": {
          "learner_id": "nlp-learner"
        }
      }
    }
  ],

  "task_result_filters": [
    {
      "tasks": ["train"],
      "filters":[
          {
          "path": "confidential_fl.app_common.filters.fixed_svt_privacy.FixedSVTPrivacy",
          "args": {
            "fraction": 1,
            "epsilon": 0.1,
            "noise_var": 1e+3,
            "gamma": 1e-4,
            "tau": 1e-8
          }
        }
      ]
    } 
  ],
  "task_data_filters": [
  ],

  "components": [
    {
      "id": "nlp-learner",
      "path": "pt.learners.wiki_learner.WikiLearner",
      "args": {
        "model_name": "gpt2",
        "learning_rate": 5e-5,
        "batch_size": 16,
        "aggregation_epochs": 1
      }
    }
  ]
}
