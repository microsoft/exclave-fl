# Settings for your Azure deployment.
#
#   cp config.env.example config.env     # then fill in config.env
#
# config.env goes into every image: rebuild and re-measure an image after changing a value it uses.

# --- Azure resources ---
# Create the resource group and the storage account in West Europe (the scripts use westeurope).
RESOURCE_GROUP=""             # resource group that holds everything
STORAGE_ACCOUNT=""            # storage account for the measured .vhd files and the attestation policies
GALLERY=""                    # Azure Compute Gallery for the CVM images (created if missing)
IMAGE_VERSION="1.0.0"         # gallery image version, MAJOR.MINOR.PATCH

# --- DNS names ---
# Added to DNS labels, VM and OS disk names: lowercase, starts with a letter, not with "site".
DNS_PREFIX=""

# --- Attestation ---
MAA_NAME=""                   # your Microsoft Azure Attestation instance, created by confidential-vm/proxy/maa
MAA_ENDPOINT=""               # its host name without https://, e.g. myattest.weu.attest.azure.net (set_policy.sh prints it)

# --- Proxy images ---
# Registry for the 5 cvm-*-proxy images; it must allow anonymous pull (see README.md, section 1).
IMAGESERVER=""                # e.g. myregistry.azurecr.io

# --- SSH ---
# Every VM gets your ~/.ssh/id_rsa.pub, and you log in to every VM as workspace.
