From a473ae12f01ab1ad1772f8299cbb15441c656329 Mon Sep 17 00:00:00 2001
From: Jinnan Guo <Jinnan-Guo@users.noreply.github.com>
Date: Fri, 6 Nov 2026 20:10:36 +0000
Subject: [PATCH] Use reportdata/hostdata as client-payload keys

The exclave-fl attestation policies check
x-ms-runtime.client-payload.hostdata. Rename the two payload keys to
"reportdata" and "hostdata" so the token claims match the policies.
---
 cvm-attestation-sample-app/main.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cvm-attestation-sample-app/main.cpp b/cvm-attestation-sample-app/main.cpp
index 9ea6866..5337658 100644
--- a/cvm-attestation-sample-app/main.cpp
+++ b/cvm-attestation-sample-app/main.cpp
@@ -119,7 +119,7 @@ int main(int argc, char* argv[]) {
         // parameters for the Attest call       
         attest::ClientParameters params = {};
         params.attestation_endpoint_url = (unsigned char*)attestation_url.c_str();
-	std::string client_payload_str = "{\"nonce\":\"" + nonce + "\", \"report_data\":\"" + report_data + "\", \"host_data\":\"" + host_data + "\"}"; // nonce is optional, report_data is base64 encoded in the response jwt
+	std::string client_payload_str = "{\"nonce\":\"" + nonce + "\", \"reportdata\":\"" + report_data + "\", \"hostdata\":\"" + host_data + "\"}"; // nonce is optional; key names match the attestation policies (x-ms-runtime.client-payload.hostdata)
 	params.client_payload = (unsigned char*) client_payload_str.c_str();
         params.version = CLIENT_PARAMS_VERSION;
         unsigned char* jwt = nullptr;
